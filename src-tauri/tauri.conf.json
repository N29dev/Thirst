{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Thirst",
  "version": "0.4.0",
  "identifier": "dev.n29.thirst",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Thirst",
        "width": 1240,
        "height": 820,
        "minWidth": 740,
        "minHeight": 620,
        "backgroundColor": "#0b1019"
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": "default-src 'self'; img-src 'self' data: https://rbxcdn.com https://*.rbxcdn.com; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "resources/*"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
