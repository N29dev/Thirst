{
  "name": "thirst",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "tauri": "tauri",
    "bundle:mac": "bash scripts/prepare_macos_bundle.sh && tauri build --bundles app",
    "bundle:windows": "tauri build --bundles nsis",
    "test:flags": "node --experimental-strip-types --test tests/fflags.test.mjs",
    "icons": "tauri icon src-tauri/icons/thirst.svg",
    "predev": "npm run icons",
    "prebuild": "npm run icons"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.8.0",
    "vite": "^6.0.0"
  }
}
